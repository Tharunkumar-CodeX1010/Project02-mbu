# MovieScope environment configuration
# Copy this file to .env and fill in your local MySQL credentials.

# Flask
SECRET_KEY=replace-with-a-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=moviescope

# Demo profile shown on first load (seed user_id 1 = Aarav Sharma)
DEMO_USER_ID=1

# Recommendation tuning: Bayesian minimum rating count (m)
MIN_RATING_COUNT=10
