# MovieScope environment configuration
# Copy this file to .env and use a PostgreSQL connection string.

# Flask
SECRET_KEY=replace-with-a-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1

# PostgreSQL (Neon: copy the pooled connection string from the project dashboard)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Demo profile shown on first load (seed user_id 1 = Aarav Sharma)
DEMO_USER_ID=1

# Recommendation tuning: Bayesian minimum rating count (m)
MIN_RATING_COUNT=10
